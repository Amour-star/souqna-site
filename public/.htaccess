# Souqna web app — Apache/LiteSpeed configuration for Hostinger.
#
# The site is a single-page application: every route that is not a real file
# must fall through to index.html so deep links such as /listing/<slug> work
# on a hard refresh. Static compliance pages (privacy.html, terms.html, …)
# are real files and are served directly by the first condition below.

# `/` is served from the prerendered home.html when it exists (see
# scripts/prerender.mjs); index.html stays the neutral SPA fallback shell.
DirectoryIndex home.html index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host + HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Prerendered pages (scripts/prerender.mjs). Each rule fires only when the
  # matching file exists, so a route that was not prerendered — or a missing
  # file — simply falls through to the SPA below.
  RewriteCond %{DOCUMENT_ROOT}/listing/$1.html -f
  RewriteRule ^listing/(?:.*-)?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/?$ /listing/$1.html [NC,L]

  RewriteCond %{DOCUMENT_ROOT}/category/$1.html -f
  RewriteRule ^category/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/?$ /category/$1.html [NC,L]

  RewriteCond %{DOCUMENT_ROOT}/category/$1__$2.html -f
  RewriteRule ^category/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/?$ /category/$1__$2.html [NC,L]

  # Never rewrite existing files or directories.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is handled by the client-side router.
  RewriteRule ^ index.html [L]
</IfModule>

# Long-lived caching for fingerprinted build assets.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # HTML (the SPA shell and every prerendered page) must always be revalidated so
  # a deploy reaches users at once; fingerprinted assets below are cached forever.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
